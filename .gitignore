# Local Claude config / artifacts (kept private; not shared publicly)
.claude/*
# ...except the Spec Kit skills generated by the Specify CLI, which are shared
# so every contributor gets the same /speckit-* workflow. Re-including a path
# under an ignored directory requires un-ignoring each level in turn.
!.claude/skills/
.claude/skills/*
!.claude/skills/speckit-*/

# Node / JS
node_modules/
web/node_modules/
npm-debug.log*
yarn-debug.log*
pnpm-debug.log*
*.log

# App runtime
.env
.env.*
!.env.sample
data/
web/dist/
bin/
ngrok

# Spec Kit Nightshift run state, evidence and logs (local to each machine)
.nightshift/

# OS / editor
.DS_Store
Thumbs.db
*.swp
